APP_NAME="Premium Business Den"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://premiumden.co.ke
APP_LOCALE=en
APP_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Local development can use SQLite; production can use MySQL by setting DB_CONNECTION=mysql.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@premiumden.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# Keep disabled until a provider is configured. Use mock only in local/test environments.
PAYMENT_DRIVER=disabled
PAYMENT_CALLBACK_SECRET=
# Daraja M-PESA Express. Start with sandbox; production requires Safaricom go-live credentials and a public HTTPS callback.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Safaricom callback IP allowlist (keep current with Daraja documentation).
DARAJA_CALLBACK_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69
CONTACT_TO_ADDRESS=
